{
  "name": "dokploy-to-pangolin",
  "module": "index.ts",
  "type": "module",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "bun run --watch ./src/index.ts",
    "build": "bun run build.ts",
    "start": "bun ./build/index.js",
    "reconcile": "bun ./src/reconcile.ts",
    "gen:api": "openapi-typescript ./assets/pangolin-openapi.yml --output src/lib/pangolin.d.ts",
    "lint:fix": "biome check --write .",
    "lint": "biome check .",
    "prepare": "husky",
    "check": "tsc --noEmit",
    "test": "for f in $(find src -name '*.test.ts' | sort); do bun test \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3 || ^7.0.0"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "openapi-fetch": "^0.17.0"
  },
  "packageManager": "bun@1.3.10"
}
